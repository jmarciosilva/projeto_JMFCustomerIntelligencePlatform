# ============================================================================
# JMF Customer Intelligence SDK — Configuração
# ============================================================================
#
# Copie este arquivo para .env na sua aplicação e preencha as variáveis.
#

# Se deve ativar o SDK (true) ou desabilitar (false)
# Padrão: true
JMF_CI_ENABLED=true

# URL base da plataforma JMF Customer Intelligence
# Exemplo: https://ci.jmfsystem.com/api/v1
# Obrigatório quando JMF_CI_ENABLED=true
JMF_CI_BASE_URL=https://ci.example.com/api/v1

# Token de autenticação gerado no painel admin da plataforma
# (Tenants > Applications > Tokens)
# Obrigatório quando JMF_CI_ENABLED=true
JMF_CI_TOKEN=seu_token_aqui

# Timeout de requisições HTTP (em segundos)
# Padrão: 5
JMF_CI_TIMEOUT=5

# Número de tentativas de envio
# Padrão: 3
JMF_CI_TRIES=3

# Delays de retry com exponential backoff (em segundos, separados por vírgula)
# Padrão: 5,30,120 (5s, 30s, 2min)
# Aplicado para erros de rede, 5xx e 429
JMF_CI_BACKOFF=5,30,120

# Conexão de fila (leave empty para usar a padrão da app)
# Exemplo: database, redis, sqs
# Padrão: (vazio = usa a padrão)
JMF_CI_QUEUE_CONNECTION=database

# Nome da fila (leave empty para usar a padrão da app)
# Padrão: (vazio = usa a padrão)
JMF_CI_QUEUE=

# Modo síncrono (true = aguarda resposta, false = fila assíncrona)
# Use true apenas para desenvolvimento/testes
# Padrão: false
JMF_CI_SYNC=false

# Validar configuração no boot do ServiceProvider
# Padrão: true
JMF_CI_VALIDATE_ON_BOOT=true

# Cookies de identificação (opcional, deixe vazio para usar padrão)
# Nome do cookie de visitante anônimo
# Padrão: jmf_ci_visitor_id
JMF_CI_VISITOR_COOKIE_NAME=jmf_ci_visitor_id

# Duração do cookie de visitante (em minutos)
# Padrão: 1051200 (2 anos)
JMF_CI_VISITOR_COOKIE_MINUTES=1051200

# Nome do cookie de sessão
# Padrão: jmf_ci_session_id
JMF_CI_SESSION_COOKIE_NAME=jmf_ci_session_id

# Duração do cookie de sessão (em minutos)
# Padrão: 30
JMF_CI_SESSION_COOKIE_MINUTES=30
